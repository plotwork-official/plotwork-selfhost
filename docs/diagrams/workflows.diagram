# after an edit to keep it there, then run plotwork generate.
flow "publish" direction=down desc="5 jobs of the publish workflow, started by a push of a tag v*, in the order their needs set, imported from GitHub Actions."

node on terminal "Push"
node verify step "Check the tag and the files" sub="ubuntu-latest, 4 steps"
node publish step "Build, push, sign and attest" sub="ubuntu-latest, 13 steps" icon=simple:qemu
node smoke step "Pull the published image and run it" sub="ubuntu-latest, 2 steps" icon=simple:sigstore
node chart step "Package, push and sign the Helm chart" sub="ubuntu-latest, 8 steps" icon=simple:sigstore
node release step "Cut the GitHub Release" sub="ubuntu-latest, 2 steps"

on -> verify
verify -> publish
publish -> smoke
verify -> chart
publish -> chart
smoke -> chart
verify -> release
publish -> release
smoke -> release
chart -> release
